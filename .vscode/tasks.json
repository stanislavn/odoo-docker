{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔍 Check All Tables",
      "type": "shell",
      "command": "PGPASSWORD=odoo psql -h db -U odoo -d odoo_db -c \"\\dt\"",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "📋 Check estate_property Table",
      "type": "shell",
      "command": "PGPASSWORD=odoo psql -h db -U odoo -d odoo_db -c \"\\d estate_property\"",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "📝 Run Custom SQL Query",
      "type": "shell",
      "command": "PGPASSWORD=odoo psql -h db -U odoo -d odoo_db -c \"${input:sqlQuery}\"",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Full Docker Rebuild",
      "type": "shell",
      "command": "docker-compose down && docker-compose build && docker-compose up -d",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sqlQuery",
      "description": "Enter SQL query to run:",
      "default": "SELECT * FROM ir_module_module LIMIT 5;",
      "type": "promptString"
    }
  ]
}
