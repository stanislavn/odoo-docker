{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🔄 Restart Odoo",
            "type": "shell",
            "command": "docker-compose restart odoo18",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "🔍 Check Tables",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "exec",
                "db",
                "psql",
                "-U",
                "odoo",
                "-d",
                "odoo_db",
                "-c",
                "\\dt"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "📋 Check estate_property Table",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "exec",
                "db",
                "psql",
                "-U",
                "odoo",
                "-d",
                "odoo_db",
                "-c",
                "\\d estate_property"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "🔄 Restart All Containers",
            "type": "shell",
            "command": "docker-compose down && docker-compose up -d",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
} 