{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🔄 Restart Odoo",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["restart", "odoo18"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "name": "🔍 Check Tables",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "exec",
        "db",
        "psql",
        "-U",
        "odoo",
        "-d",
        "odoo_db",
        "-c",
        "\\dt"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "name": "📋 Check estate_property Table",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": [
        "exec",
        "db",
        "psql",
        "-U",
        "odoo",
        "-d",
        "odoo_db",
        "-c",
        "\\d estate_property"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "name": "🔄 Restart All Containers",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["down", "&&", "docker-compose", "up", "-d"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "name": "Debug Odoo",
      "type": "python",
      "request": "launch",
      "program": "/usr/bin/odoo",
      "args": [
        "-c",
        "/etc/odoo/odoo.conf",
        "-d",
        "odoo_db",
        "--db_user=odoo",
        "--db_password=odoo",
        "--db_host=db",
        "--dev=all"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
