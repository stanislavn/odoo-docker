<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_l10n_sk_invoice" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n.sk.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="specific_symbol" visibility="partner_id.country_id.code == 'SK'"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="taxable_supply_date" visibility="partner_id.country_id.code == 'SK'"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_company_registry" readonly="1"/>
                <field name="partner_vat_local" readonly="1" visibility="partner_id.country_id.code == 'SK'"/>
            </xpath>
        </field>
    </record>
</odoo>